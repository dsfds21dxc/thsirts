# === REQUIRED ===
# Open Cloud API key with "Creator Store" (Assets) read+write permission
ROBLOX_API_KEY=your_open_cloud_api_key_here

# Your .ROBLOSECURITY cookie (needed to set T-shirts on sale and get user ID)
ROBLOSECURITY=your_roblosecurity_cookie_here

# === OPTIONAL ===
# Group ID — if set, T-shirts are created under this group instead of your user
# GROUP_ID=

# Server port (Render sets this automatically)
# PORT=3000
